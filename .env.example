# KisanStatus.com Environment Variables Template
# ──────────────────────────────────────────────────────────────────────────────
# STEP 1: Copy this file to .env.local
#         cp .env.example .env.local
#
# STEP 2: Fill in your actual values in .env.local
#
# STEP 3: Never commit .env.local to git (it's in .gitignore)
# ──────────────────────────────────────────────────────────────────────────────

# Google Analytics 4 Measurement ID
# Get from: https://analytics.google.com → Admin → Data Streams → Measurement ID
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site URL (used for canonical URLs and sitemaps)
NEXT_PUBLIC_SITE_URL=https://kisanstatus.com

# Google Search Console verification token
# Get from: https://search.google.com/search-console
# (Optional — also settable in next.config.js metadata)
NEXT_PUBLIC_GSC_TOKEN=YOUR_GSC_VERIFICATION_TOKEN

# ──────────────────────────────────────────────────────────────────────────────
# LIVE DATA API KEYS — Mandi Rates + Weather
# ──────────────────────────────────────────────────────────────────────────────

# Mandi Rates API Key (data.gov.in - Agricultural Marketing Network)
# Get from: https://data.gov.in → My Account → API Key
# Note: Public sample key provided below (limited to 10 records per request)
# For production with more data, register and get your own API key
# Documentation: https://data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
NEXT_PUBLIC_MANDI_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b

# Weather API Key (OpenWeatherMap)
# Get from: https://openweathermap.org/api → Sign up for free → API Keys
# Free tier supports:
#   - Current weather data
#   - 5-day forecast
#   - Weather alerts
# Documentation: https://openweathermap.org/api/weather-alerts
NEXT_PUBLIC_WEATHER_API_KEY=YOUR_OPENWEATHERMAP_API_KEY

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Database (if needed in future)
# ──────────────────────────────────────────────────────────────────────────────

# DATABASE_URL=your_database_connection_string

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Email Service (if implementing newsletter/contact form)
# ──────────────────────────────────────────────────────────────────────────────

# SENDGRID_API_KEY=your_sendgrid_api_key
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
