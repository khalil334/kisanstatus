# KisanStatus.com Environment Variables Template
# ──────────────────────────────────────────────────────────────────────────────
# STEP 1: Copy this file to .env.local
#         cp .env.example .env.local
#
# STEP 2: Fill in your actual values in .env.local
#
# STEP 3: Never commit .env.local to git (it's in .gitignore)
# ──────────────────────────────────────────────────────────────────────────────

# Google Analytics 4 Measurement ID
# Get from: https://analytics.google.com → Admin → Data Streams → Measurement ID
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site URL (used for canonical URLs and sitemaps)
NEXT_PUBLIC_SITE_URL=https://kisanstatus.com

# Google Search Console verification token
# Get from: https://search.google.com/search-console
# (Optional — also settable in next.config.js metadata)
NEXT_PUBLIC_GSC_TOKEN=YOUR_GSC_VERIFICATION_TOKEN

# ──────────────────────────────────────────────────────────────────────────────
# LIVE DATA API KEYS — Mandi Rates + Weather
# ──────────────────────────────────────────────────────────────────────────────

# Mandi Rates API Key (data.gov.in - Agricultural Marketing Network)
# Get from: https://data.gov.in → My Account → API Key
# Note: data.gov.in publishes a shared sample key in its docs (limited records); do NOT
# commit it or any real key here — this file is an example, secrets live in Vercel env vars.
# Documentation: https://data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
#
# SERVER-ONLY — no NEXT_PUBLIC_ prefix (BUG-8). The browser never sees this key; it is
# read only by the route handler `app/api/mandi/route.ts`, which the client calls at
# /api/mandi?state=... Anything named NEXT_PUBLIC_* is inlined into the JS bundle and
# extractable by any visitor, so do NOT rename this back.
#
# Migration note for the Vercel project: add MANDI_API_KEY with the same value, then
# DELETE the old NEXT_PUBLIC_MANDI_API_KEY and redeploy. The route still falls back to
# the old name so nothing breaks in between, but the key keeps shipping to the client
# until the public var is removed.
MANDI_API_KEY=YOUR_DATA_GOV_IN_API_KEY

# Weather API Key (OpenWeatherMap)
# Get from: https://openweathermap.org/api → Sign up for free → API Keys
# Free tier supports:
#   - Current weather data
#   - 5-day forecast
#   - Weather alerts
# Documentation: https://openweathermap.org/api/weather-alerts
# SERVER-ONLY (BUG-8 part 2): the key is read in app/api/weather/route.ts, never in the
# client bundle. Migration note for the Vercel project: add WEATHER_API_KEY with the
# same value, then DELETE the old NEXT_PUBLIC_WEATHER_API_KEY and redeploy. The route
# still falls back to the old name so nothing breaks in between, but the key keeps
# shipping to the client until the public var is removed.
WEATHER_API_KEY=YOUR_OPENWEATHERMAP_API_KEY

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Database (if needed in future)
# ──────────────────────────────────────────────────────────────────────────────

# DATABASE_URL=your_database_connection_string

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Email Service (if implementing newsletter/contact form)
# ──────────────────────────────────────────────────────────────────────────────

# SENDGRID_API_KEY=your_sendgrid_api_key
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
