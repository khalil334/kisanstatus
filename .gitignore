# Git ignore file for KisanStatus.in Next.js project

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/

# Production build
dist/
build/

# Environment files — NEVER commit these
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# Dot-less variants — 'env.local' slipped past the .env.local rule and got
# committed once (see SEO-AUDIT.md). Keep these patterns.
env.local
env.*.local
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Backups written by scripts/update-article-dates.js on every `npm run build`
*.backup-*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/
