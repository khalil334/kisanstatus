{
  "name": "kisanstatus-com",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:titles && npm run update-dates && next build",
    "start": "next start",
    "lint": "eslint .",
    "update-dates": "node scripts/update-article-dates.js",
    "check:titles": "node scripts/check-title-h1.js",
    "indexnow:build": "node scripts/build-indexnow-payload.js",
    "indexnow:submit": "node scripts/build-indexnow-payload.js && node scripts/submit-indexnow.js",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.1.0",
    "next": "16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "browserslist": [
    "defaults and supports es6-module",
    "not dead",
    "not ie 11",
    "not op_mini all"
  ]
}
